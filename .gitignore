# Root gitignore
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# Backend ignore
backend/.env
backend/.env.backup
backend/.env.production
backend/vendor/
backend/storage/*.key
backend/storage/logs/
backend/public/storage
backend/node_modules/

# Frontend ignore
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
